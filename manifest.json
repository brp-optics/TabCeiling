{
  "manifest_version": 2,
  "name": "Tab Ceiling",
  "version": "1.3.0",
  "description": "Caps how many new tabs you can open, and can collapse links that want a new tab into the tab you tapped them from.",
  "browser_specific_settings": {
    "gecko": {
      "id": "tab-ceiling@example.com",
      "strict_min_version": "115.0", 
      "data_collection_permissions": { "required": ["none"] }
        },
    "gecko_android": {
      "strict_min_version": "115.0"
    }
  },

  "permissions": [
    "tabs",
    "storage"
  ],

  "browser_action": {
    "default_title": "Tab Ceiling",
    "default_popup": "popup.html",
    "default_icon": "icon.svg"
  },

  "background": {
    "scripts": ["settings.js", "background.js"],
    "persistent": true
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
