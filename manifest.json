{
  "manifest_version": 2,
  "name": "Tab Ceiling",
  "version": "1.1.0",
  "description": "Caps open tabs at a number you choose and stops links from spawning new ones.",

  "browser_specific_settings": {
    "gecko": {
      "id": "tab-ceiling@yourname.example",
      "strict_min_version": "115.0"
    },
    "gecko_android": {
      "strict_min_version": "115.0"
    }
  },

  "permissions": [
    "tabs",
    "storage"
  ],

  "browser_action": {
    "default_title": "Tab Ceiling",
    "default_popup": "popup.html",
    "default_icon": "icon.svg"
  },

  "background": {
    "scripts": ["settings.js", "background.js"],
    "persistent": true
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
